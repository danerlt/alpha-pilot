# =============================================================================
# AlphaPilot 环境变量模板（唯一模板, 提交 git）
#
# 原则（2026-07 起）：env 只放【中间件连接】+【服务启动/安全】。
#   业务配置一律走数据库（前端 设置页 加密入库, DB 优先于 env）:
#     · 交易所 API Key（币安）  → 设置→交易所连接   (PUT /api/settings/exchange)
#     · LLM Key/模型/BaseURL    → 设置→AI 模型       (PUT /api/settings/llm)
#     · 通知 Telegram/级别      → 设置→通知           (PUT /api/settings/notifications)
#     · 风控阈值                → DB risk_profile（启动自动建默认 active 档）
#   这些字段代码里都有安全默认（缺 Key 自动回退 Mock, 决策恒 HOLD 不误下单）, 故 env 不再配。
#   (Email SMTP 告警若要用, 字段见 backend/src/configs/app_configs.py NotificationConfig, 走 env。)
#
# 部署：拷本文件到 envs/<env>.env 填值 → Makefile/部署脚本 --env-file 加载;
#   直接 python 跑时拷 envs/<env>.env 到项目根 .env（dotenv 默认读根 .env）。
#   Claude 只读写本文件; envs/ 与根 .env 为老板专属。
# =============================================================================

# ── 服务启动 ─────────────────────────────────────────────────────────────────
ENVIRONMENT=dev               # dev | uat | prod | test | local
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
UVICORN_WORKER_NUM=2          # api 进程 uvicorn worker 数; 单机 2-4
FASTAPI_ROOT_PATH=            # 子路径部署填(如 /ap-dev); docker 里由 ROOT_PATH 注入, 通常留空
# 运行网络兜底默认（前端可切换, DB 优先; 仅防呆, 保证不误上主网）
TRADING_MODE=testnet          # testnet | mainnet

# ── 中间件: PostgreSQL ───────────────────────────────────────────────────────
# docker 部署: app 栈 DATABASE_URL 由 compose 用 ${DB_PASSWORD} 拼, 连共享中间件 ap-postgres。
# 直接 python 跑: 留空 DATABASE_URL, 按 PG_* 字段拼 db_uri。
PG_USER=alphapilot
PG_PASSWORD=alphapilot        # 直接 python 用; 真实环境填强随机, 须 == DB_PASSWORD
PG_HOST=localhost
PG_PORT=5442                  # 各环境示例: local=5442
PG_DB=alphapilot
DATABASE_URL=                 # 显式 postgresql:// 覆盖, 否则按 PG_* 拼

# ── 中间件: Redis ────────────────────────────────────────────────────────────
# 服务器 Redis 已启用密码, URL 必须带密码段: redis://:<REDIS_PASSWORD>@host:port/db
REDIS_URL=redis://localhost:6389/0     # 本地无密码占位; 服务器填带密码的

# ── 中间件密码（docker compose 变量替换用; 须与服务器 docker/.env 完全一致）──
# app 栈的 DATABASE_URL/REDIS_URL 由 compose 用这俩变量拼(--env-file envs/<env>.env)。
DB_PASSWORD=                  # == PG_PASSWORD == docker/.env DB_PASSWORD（也 == 服务器 ALTER USER 的值）
REDIS_PASSWORD=               # == docker/.env REDIS_PASSWORD（也是 REDIS_URL 里的密码段）

# ── 安全（启动必填, 否则 _validate_secrets 抛 InsecureSecretError）────────────
# APP_CONFIG_MASTER_KEY 是解密 DB 内业务密钥(币安/LLM Key)的根, 必须且只能放 env。
APP_AUTH_SECRET_KEY=          # 生成: openssl rand -hex 32
APP_CONFIG_MASTER_KEY=        # 生成: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 默认管理员引导（仅 dev/test 建议; 留空则跳过。生产勿用固定密码）
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_PASSWORD=

# ── 调度（服务启动/行为; 均有默认, 通常只需按需调下面 4 个）───────────────────
STRATEGY_LOOP_INTERVAL_MINUTES=15       # 策略循环触发间隔
POSITION_MONITOR_INTERVAL_SECONDS=10    # 持仓监控触发间隔
PIPELINE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
PIPELINE_TIMEFRAMES=1h
# 其余有默认, 不用配: APSCHEDULER_JOBS_TABLE / TASK_QUEUE_KEY / EVENT_BUS_CHANNEL /
#   EVENT_SHUTTLE_* / SCHEDULER_GRACEFUL_SHUTDOWN_SECONDS / STRATEGY_SCORING_INTERVAL_HOURS

# ── CORS（可选）──────────────────────────────────────────────────────────────
ENABLE_CORS=true
CORS_ALLOWED_ORIGINS=["*"]    # 生产填具体域名
