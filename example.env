# AlphaPilot env 模板（唯一模板, 提交 git）。env 只放中间件 + 服务启动/安全;
# 业务配置（币安/LLM/通知/风控阈值）走前端设置页 → DB。拷到 envs/<env>.env 填值。

# ── 服务启动 ──
ENVIRONMENT=dev               # dev | uat | prod | test | local
LOG_LEVEL=INFO
UVICORN_WORKER_NUM=2
FASTAPI_ROOT_PATH=            # docker 里由 ROOT_PATH 注入, 通常留空
TRADING_MODE=testnet          # 兜底默认; 前端可切, DB 优先

# ── 中间件: PostgreSQL ──
PG_USER=alphapilot
PG_PASSWORD=alphapilot        # 真实环境填强随机, 须 == DB_PASSWORD
PG_HOST=localhost
PG_PORT=59133
PG_DB=alphapilot
POOL_SIZE=20
POOL_MAX_OVERFLOW=20
DB_CONNECT_TIMEOUT=10         # seconds
PRINT_SQL=false               # true 时 echo SQL(仅 dev)
DATABASE_URL=                 # 显式 postgresql:// 覆盖, 否则按 PG_* 拼

# ── 中间件: Redis ──
REDIS_URL=redis://@ap-redis:46730/0

# ── 中间件密码（docker compose 变量替换用, 须与服务器 docker/.env 一致）──
DB_PASSWORD=
REDIS_PASSWORD=

# ── 安全（启动必填, 否则 InsecureSecretError）──
# # Critical: JWT 签发密钥; 生成: openssl rand -hex 32
APP_AUTH_SECRET_KEY=
# 生成: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_CONFIG_MASTER_KEY=

# 默认管理员引导 (仅 dev/test 建议; 留空则跳过)
# WARNING: 真实邮箱/密码绝对不要写到 example.env, 自查 git diff.
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_PASSWORD=

# ── 调度 ──
STRATEGY_LOOP_INTERVAL_MINUTES=3
POSITION_MONITOR_INTERVAL_SECONDS=10
CONFIG_REFRESH_INTERVAL_SECONDS=10      # [opt] DB 配置兜底刷新间隔(秒), 前端改配置 ~此值内生效(ADR-0001 P1)
PIPELINE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT   # 现为 seed/兜底; 交易标的真相源是 symbol_configs 表(前端可增删启停)
PIPELINE_TIMEFRAMES=1h
APSCHEDULER_JOBS_TABLE=apscheduler_jobs # [opt]
TASK_QUEUE_KEY=alphapilot:tasks         # [opt] Redis list key
EVENT_BUS_CHANNEL=alphapilot:events     # [opt] Redis pub/sub channel 前缀
EVENT_SHUTTLE_BATCH_SIZE=50             # [opt]
EVENT_SHUTTLE_IDLE_SLEEP_SECONDS=0.5    # [opt]
EVENT_SHUTTLE_MAX_FAILED_ATTEMPTS=3     # outbox 行 publish 失败 N 次后写死信
SCHEDULER_GRACEFUL_SHUTDOWN_SECONDS=60  # [opt] SIGTERM 后等 job 收尾的窗口
STRATEGY_SCORING_INTERVAL_HOURS=24      # [opt] 策略评分 job 间隔(小时); 低频聚合历史交易

# ── CORS ──
ENABLE_CORS=true
CORS_ALLOWED_ORIGINS=["*"]    # 生产填具体域名
CORS_EXPOSE_HEADERS=["X-Request-ID"]  # [opt]